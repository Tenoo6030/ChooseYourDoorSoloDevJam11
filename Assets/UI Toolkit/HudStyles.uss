.HealtBar {
    flex-grow: 1;
    right: 0;
    left: 550px;
    top: 0;
    position: absolute;
    width: 800px;
    height: 50px;
    background-color: rgb(135, 135, 135);
}

.HealtText {
    height: 40px;
    font-size: 0;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.HealtText:hover {
    height: 40px;
    font-size: 50px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(0, 0, 0);
}
